# Mock IdP (dev, demo, e2e only). Copy to .env or export before `pnpm start`.
MOCK_IDP_PORT=4000
# Must equal the API's AUTH_ISSUER / AUTH_AUDIENCE.
AUTH_ISSUER=http://localhost:4000
AUTH_AUDIENCE=xml-invoice-processor
# client_id -> secret and the claims its tokens carry. Use your own secrets.
MOCK_IDP_CLIENTS={"supplier-client":{"secret":"change-me","org_id":"org-supplier","peppol_id":"0106:11111111","scopes":["documents:submit","documents:read"]}}
# The public client support-web (Authorization Code + PKCE, ADR 0017) for the support app: the
# exact redirect URIs it may use (comma-separated; their origins also get CORS on /token) and the
# demo support employees who can sign in. Leave both unset to switch the client off.
MOCK_IDP_SUPPORT_REDIRECT_URIS=https://localhost:5443/callback
MOCK_IDP_SUPPORT_USERS={"support-agent":{"password":"change-me"}}
# Other browser origins that may call /token, exact and comma-separated: the API's Swagger UI
# (its Authorize button, ADR 0019). Empty: only the support app's origins.
MOCK_IDP_CORS_ORIGINS=http://localhost:3000
