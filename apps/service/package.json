{
  "name": "@xip/service",
  "private": true,
  "description": "API (intake) and worker (processing) for Peppol invoices. One codebase, two processes.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "rm -rf dist && swc src -d dist --strip-leading-paths --config-file .swcrc --ignore \"**/*.spec.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:e2e": "vitest run --project e2e",
    "test:chaos": "vitest run --project chaos --reporter=verbose",
    "start:api": "node --enable-source-maps dist/main-api.js",
    "start:worker": "node --enable-source-maps dist/main-worker.js",
    "dev:api": "node --watch-path=dist --enable-source-maps dist/main-api.js",
    "dev:worker": "node --watch-path=dist --enable-source-maps dist/main-worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "build:watch": "swc src -d dist --strip-leading-paths --config-file .swcrc --ignore \"**/*.spec.ts\" --watch",
    "build:validation": "bash scripts/validation/fetch-and-compile.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1165.0",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/cqrs": "12.1.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "amqp-connection-manager": "5.0.1",
    "amqplib": "2.3.1",
    "helmet": "8.3.0",
    "jose": "6.2.17",
    "libxml2-wasm": "0.7.2",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "piscina": "5.3.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "saxon-js": "2.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.4.2",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "xslt3": "2.7.0"
  }
}
