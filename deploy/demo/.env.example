# The public demo (deploy/demo/README.md, ADR 0019): the server-side settings for
#   docker compose --env-file deploy/demo/.env -f docker-compose.yml -f deploy/demo/compose.yml --profile full ...
# `sh deploy/demo/generate-env.sh` copies this file to deploy/demo/.env (gitignored, mode 600) and
# fills every empty secret with a random value. Never commit the result.

# The published images to run (the server pulls; it never builds).
TAG=

# Public hostnames: their DNS A/AAAA records point to the server. One certificate each, from
# Let's Encrypt over the TLS-ALPN challenge on port 443.
DEMO_WEB_HOST=demo.huizeblok.nl
DEMO_API_HOST=api.demo.huizeblok.nl
DEMO_IDP_HOST=idp.demo.huizeblok.nl
# Let's Encrypt's contact address for the account (expiry and incident mail).
ACME_EMAIL=
# Optional: the ACME directory. Let's Encrypt staging for a dry run, without its rate limits:
# https://acme-staging-v02.api.letsencrypt.org/directory (browsers do not trust its certificates).
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# Secrets: required, without defaults (compose refuses to start without them). Generated.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
S3_SECRET_ACCESS_KEY=
# The demo clients and the support employee keep their names (supplier-client, customer-client,
# support-agent); only their secrets are new. Hand them to the testers, not to the repository.
DEMO_SUPPLIER_SECRET=
DEMO_CUSTOMER_SECRET=
DEMO_SUPPORT_PASSWORD=
