# Keep the build context small and free of secrets: images are built from the lockfile and
# sources only. Anything generated is regenerated inside the build.
.git
.github
docs
**/node_modules
**/dist
**/coverage
**/*.log
**/.env
**/.env.*
apps/service/src/generated
apps/service/validation-artifacts/generated

# Tests are not part of an image.
apps/*/test
**/*.spec.ts
**/*.spec.tsx

.DS_Store
.idea
.vscode
