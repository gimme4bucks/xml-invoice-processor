# Copy to .env (root and apps/service) for local development. Never commit real secrets.
# Docker Compose also reads the root .env for the ${...} defaults in docker-compose.yml.

# Postgres (docker compose)
POSTGRES_USER=xip
POSTGRES_PASSWORD=xip
POSTGRES_DB=xip
POSTGRES_PORT=5432
DATABASE_URL=postgresql://xip:xip@localhost:5432/xip

# RabbitMQ (docker compose)
RABBITMQ_USER=xip
RABBITMQ_PASSWORD=xip
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
AMQP_URL=amqp://xip:xip@localhost:5672
# TTLs of the three retry delay queues. Changing them needs a new AMQP_PREFIX (queue arguments).
RETRY_DELAYS_MS=1000,2000,5000

# Service
# ADAPTERS=real: Postgres, RabbitMQ, libxml2/SaxonJS and the fake VIES (the full compose stack
# needs this). ADAPTERS=in-memory runs the walking skeleton without any infrastructure.
ADAPTERS=real
API_PORT=3000
LOG_LEVEL=info
# Requests per minute per organisation, per API instance.
RATE_LIMIT_PER_MINUTE=600
# Behind exactly one reverse proxy (the HTTPS edge in compose sets it to true): take the client
# address and scheme from the X-Forwarded-* entries that proxy added. Off when clients connect
# directly, as in local development, because anyone can send those headers.
TRUST_PROXY=false
# Strict-Transport-Security max-age. Production keeps the default of a year (31536000); the compose
# stack sends 300, so that a browser applying HSTS to localhost is not pinned to HTTPS for a year.
HSTS_MAX_AGE_SECONDS=300

# Business rules (Schematron): worker threads and the time limit per document. The SEFs come
# from `pnpm -F @xip/service build:validation` (the Docker image builds them itself).
SCHEMATRON_POOL_SIZE=1
SCHEMATRON_TIMEOUT_MS=30000

# Fake VIES (demo stand-in for the EU VAT service): unavailable for the first N checks of every
# VAT number, then it answers; numbers in the list do not exist; a share of calls (0-1) fails.
VIES_UNAVAILABLE_TIMES_PER_NUMBER=2
VIES_INVALID_VAT_NUMBERS=NL999999999B99
VIES_UNAVAILABLE_RATE=0

# Auth: the mock IdP (apps/mock-idp, its clients are in apps/mock-idp/.env.example), running
# natively during development: plain HTTP on localhost. The full compose stack ignores
# AUTH_ISSUER and AUTH_JWKS_URL: there, the issuer is https://localhost:4443 (the HTTPS edge,
# ADR 0013) and the API fetches the keys from http://mock-idp:4000 inside the network.
AUTH_ISSUER=http://localhost:4000
AUTH_JWKS_URL=http://localhost:4000/.well-known/jwks.json
AUTH_AUDIENCE=xml-invoice-processor
MOCK_IDP_PORT=4000

# `pnpm demo` and `pnpm e2e` (against the running stack). The clients are the compose defaults.
# Both go through the HTTPS edge and trust its root certificate, which they export themselves
# (`pnpm tls:ca` writes it to .tls/edge-root-ca.crt).
API_BASE_URL=https://localhost:3443
IDP_BASE_URL=https://localhost:4443
